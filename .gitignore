# Godot editor cache and import data.
# Also holds export_credentials.cfg, where Godot keeps export passwords.
.godot/
export_credentials.cfg

# Build output (root folder only, so tools/build/ stays tracked)
/build/
*.apk
*.aab
*.idsig

# Signing keys and their passwords never go in the repo
*.keystore
*.jks
*-password.txt

# Android Gradle build template, unpacked by tools/build/build_release.sh for
# the Play bundle (AAB). The debug and release APKs use the prebuilt templates.
/android/

# Personal Claude Code settings (agent files in .claude/agents/ are committed)
.claude/settings.local.json

# The store icon is made by tools/build/store_graphics.gd. The app icon is never committed as an image.
/docs/store/graphics/icon_512.png

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini
*.tmp
